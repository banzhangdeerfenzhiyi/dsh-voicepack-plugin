{
  "name": "dsh-voicepack-plugin",
  "version": "0.1.0",
  "private": false,
  "description": "Voice pack for the WeChat persona: 15 Edge neural voices (9 female / 6 male, dialects, Cantonese, Taiwan) plus 3 optional RVC timbres, sent as native WeChat voice bubbles.",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node test/unit.test.mjs && node test/apply.test.mjs"
  },
  "dependencies": {
    "mpg123-decoder": "^1.0.3",
    "msedge-tts": "^2.1.1",
    "silk-wasm": "^3.7.1"
  },
  "license": "MIT",
  "author": "banzhangdeerfenzhiyi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/banzhangdeerfenzhiyi/dsh-voicepack-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/banzhangdeerfenzhiyi/dsh-voicepack-plugin/issues"
  },
  "homepage": "https://github.com/banzhangdeerfenzhiyi/dsh-voicepack-plugin#readme",
  "files": [
    "index.mjs",
    "src",
    "python",
    "tools",
    "test",
    "README.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin"
  ]
}
